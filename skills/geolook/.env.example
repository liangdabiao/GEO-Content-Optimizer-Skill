# GeoLook 引擎与发布凭证（复制为 .env；也可在看板「设置」里填写，会自动写入 .env）
# Engine & publishing credentials. Copy to .env, or fill them in the dashboard Settings page.
# 一个都不填也能跑：自动采样会跳过，无 API 引擎走人工采样表。
#
# ┌────────────────────────────────────────────────────────────────────┐
# │  默认模式：302.AI 统一 Key（1 把 Key 跑通 9 个 LLM 平台 + 9 个搜索）    │
# │  兜底模式：把 AI302AI_MODE 设为 0，并用下方「模式 B」的 9 把原生 Key     │
# └────────────────────────────────────────────────────────────────────┘

# ============================================================
# 模式 A（默认）：302.AI 统一 Key  ← 现在是默认
# ============================================================
# 一把 Key 解锁全部能力。设为 1 后 sample/generate/aggregate 全部走
# https://api.302ai.cn/v1（国内端点·OpenAI 兼容 + Anthropic 兼容，推荐）；
# 海外目录是 api.302.ai，模型 ID 与国内目录不同，切换前先 GET /v1/models 实测。
# 302.AI 模式下还自带 9 个搜索 provider 的联网能力。Key 在 https://302.ai 控制台申请。
# 详见 docs/302ai-integration-research.md
AI302AI_MODE=1
AI302AI_API_KEY=
AI302AI_DEEPSEEK_MODEL=deepseek-v4-pro
AI302AI_SEARCH_PROVIDER=tavily
AI302AI_GLM_MODEL=glm-5.2
AI302AI_ARK_MODEL=doubao-seed-2-1-turbo-260628
AI302AI_KIMI_MODEL=kimi-k3
AI302AI_MINIMAX_MODEL=MiniMax-M3
AI302AI_GEMINI_MODEL=gemini-3.6-flash
AI302AI_OPENAI_MODEL=gpt-5.4-mini
AI302AI_CLAUDE_MODEL=claude-sonnet-5
AI302AI_GROK_MODEL=grok-4.5
AI302AI_PERPLEXITY_MODEL=sonar

# 302.AI 模式下可覆盖默认模型（不填用 2026-08 最新稳定版）
# 默认：glm-4.7-flashx / doubao-seed-2-1-turbo-260628 / deepseek-v4-flash / kimi-k3
#       MiniMax-M2.7 / gemini-3.5-flash / gpt-5.4-mini / claude-sonnet-5 / grok-4.1 / sonar
# AI302AI_GLM_MODEL=glm-4.7-flashx
# AI302AI_ARK_MODEL=doubao-seed-2-1-turbo-260628
# AI302AI_DEEPSEEK_MODEL=deepseek-v4-flash
# AI302AI_KIMI_MODEL=kimi-k3
# AI302AI_MINIMAX_MODEL=MiniMax-M2.7
# AI302AI_GEMINI_MODEL=gemini-3.5-flash
# AI302AI_OPENAI_MODEL=gpt-5.4-mini
# AI302AI_CLAUDE_MODEL=claude-sonnet-5
# AI302AI_GROK_MODEL=grok-4.1
# AI302AI_PERPLEXITY_MODEL=sonar

# ---- 302.AI 多源搜索（9 个 provider，自动按市场分流：cn→bocha, global→tavily） ----
# 可选：覆盖默认搜索 provider（留空用市场默认）
# AI302AI_SEARCH_PROVIDER=
# 可选：search_then_ask（豆包等 302 联网组合）单次 LLM 调用超时，默认 45s。
# 历史教训：这里曾硬编码 60s 且超时重试 2 次，每题失败约 3 分钟；现在可配，别设太大。
# AI302AI_SEARCH_ASK_TIMEOUT=45
# provider 说明：bocha 中文好 / tavily 英文好 / exa 论文+GitHub / metaso 学术+视频
#                search1_search 13 平台聚合(google/微信/b站/github/arxiv) / firecrawl 带整页爬取

# ============================================================
# 模式 B（兜底）：各平台原生 Key
# ============================================================
# 当 AI302AI_MODE=0（或者 AI302AI_API_KEY 留空时）自动启用此模式。
# 想直连原平台 / 已有多平台账号 / 不走 302.AI，把下方 Key 取消注释填入，
# 并把上面 AI302AI_MODE 改为 0。
# ---- 国内引擎 CN engines ----
# ZHIPUAI_API_KEY=
# ARK_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# MINIMAX_API_KEY=

# ---- 海外引擎 Global engines ----
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=

# 可选：覆盖各引擎默认采样模型 Optional model overrides
# GLM_MODEL=  ARK_MODEL=  DEEPSEEK_MODEL=  MOONSHOT_MODEL=  MINIMAX_MODEL=
# GEMINI_MODEL=  OPENAI_MODEL=  ANTHROPIC_MODEL=  GROK_MODEL=  PERPLEXITY_MODEL=

# ============================================================
# 模式 C：OpenRouter 统一 Key（与 302.AI 互斥 · 西方模型聚合器）
# ============================================================
# 与 302.AI 互斥使用（用户只配一个）。想用 OpenRouter 时，把上面 AI302AI_MODE
# 改为 0，再启用本节，sample/generate/aggregate 会改走 https://openrouter.ai/api/v1。
# 9/10 平台覆盖（豆包 OpenRouter 无，自动跳过）：
#   DeepSeek / Kimi / MiniMax / GLM / Gemini / OpenAI / Claude / Grok / Perplexity
# 独家模型：MiniMax-M3 (1M 多模态) / Llama / Mistral / Qwen / Cohere
# 联网：OpenRouter 不提供多源搜索，靠 Perplexity sonar / Claude web search / GPT-4o search。
# 详见 docs/openrouter-integration-research.md
OPENROUTER_MODE=0
OPENROUTER_API_KEY=
# OpenRouter 模式下可覆盖默认模型（不填用 2026-08 默认）
# 默认：deepseek/deepseek-v4-flash / moonshotai/kimi-k3 / minimax/minimax-m2.7
#       z-ai/glm-4.7-flash / google/gemini-3.5-flash / openai/gpt-5.5
#       anthropic/claude-sonnet-5 / x-ai/grok-4.3 / perplexity/sonar
#       bytedance-seed/seed-2.0-mini（豆包系列）
# OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_KIMI_MODEL=moonshotai/kimi-k3
# OPENROUTER_MINIMAX_MODEL=minimax/minimax-m2.7
# OPENROUTER_GLM_MODEL=z-ai/glm-4.7-flash
# OPENROUTER_GEMINI_MODEL=google/gemini-3.5-flash
# OPENROUTER_OPENAI_MODEL=openai/gpt-5.5
# OPENROUTER_CLAUDE_MODEL=anthropic/claude-sonnet-5
# OPENROUTER_GROK_MODEL=x-ai/grok-4.3
# OPENROUTER_PERPLEXITY_MODEL=perplexity/sonar
# 豆包在 OpenRouter 上是 bytedance-seed 系列（不是 doubao-seed-*）
# OPENROUTER_ARK_MODEL=bytedance-seed/seed-2.0-mini

# ---- 发布渠道（可选）Publishing channels, optional ----
GITHUB_TOKEN=
WP_USER=
WP_APP_PASSWORD=
WECHAT_APPID=
WECHAT_APPSECRET=
PUBLISH_WEBHOOK_URL=
